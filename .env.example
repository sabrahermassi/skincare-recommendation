# Copy to `.env` and fill in. `.env` is gitignored.
#
# WITHOUT these the app still runs: data/api.ts falls back to the eight
# fabricated sample products, so a fresh checkout works with no setup.

# ── Client (safe to ship) ───────────────────────────────────────────────────
# The anon key is DESIGNED to be public. It grants only what row-level
# security allows, which here is read-only access to the public catalogue.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ── Server only — NEVER prefix these with EXPO_PUBLIC_ ──────────────────────
# Anything prefixed EXPO_PUBLIC_ is substituted into the JS bundle at build
# time and can be read straight out of a shipped app. These would give away
# full database write access, your third-party quota, and your Vision quota
# respectively.
#
# Set them in the Supabase dashboard (Edge Function secrets) and in your shell
# when running the import scripts — never in a file that reaches the client.
SUPABASE_SERVICE_ROLE_KEY=
INCI_API_KEY=
# Read by supabase/functions/label-ocr; lives only in that function's
# environment, never here or anywhere Metro can reach.
GOOGLE_VISION_API_KEY=

# ── Script runs only — set in your shell, not in this file ──────────────────
# The 11 scripts in `scripts/` all go through `connect()` in scripts/lib/db.mjs
# and read SUPABASE_URL (the same project URL as EXPO_PUBLIC_SUPABASE_URL
# above, unprefixed so Metro never inlines it) plus SUPABASE_SERVICE_ROLE_KEY.
# A script that WRITES additionally needs SUPABASE_ENV, which must be exactly
# `staging` or `production`; writing with SUPABASE_ENV=production also needs
# --prod on the command line. Every run prints the project ref it touched.
#
# Deliberately left commented out: neither name is a secret, and
# scripts/check-bundle-secrets.mjs treats every uncommented non-EXPO_PUBLIC_
# name here as forbidden in a shipped bundle. `SUPABASE_URL` is a substring of
# `EXPO_PUBLIC_SUPABASE_URL`, so declaring it would fail that check on the
# public URL it is meant to allow.
#
#   SUPABASE_URL=https://<project-ref>.supabase.co
#   SUPABASE_ENV=staging

EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
