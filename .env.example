# Copy to `.env` and fill in. `.env` is gitignored.
#
# WITHOUT these the app still runs: data/api.ts falls back to the eight
# fabricated sample products, so a fresh checkout works with no setup.

# ── Client (safe to ship) ───────────────────────────────────────────────────
# The anon key is DESIGNED to be public. It grants only what row-level
# security allows, which here is read-only access to the public catalogue.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ── Server only — NEVER prefix these with EXPO_PUBLIC_ ──────────────────────
# Anything prefixed EXPO_PUBLIC_ is substituted into the JS bundle at build
# time and can be read straight out of a shipped app. These two would give
# away full database write access and your third-party quota respectively.
#
# Set them in the Supabase dashboard (Edge Function secrets) and in your shell
# when running the import scripts — never in a file that reaches the client.
SUPABASE_SERVICE_ROLE_KEY=
INCI_API_KEY=
