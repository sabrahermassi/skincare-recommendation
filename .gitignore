# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/*
# Typed routes are generated by `expo start` only — never by `expo export`.
# Commit them so CI typechecks hrefs as strictly as local dev does: without
# this file expo-router's Href type silently widens to plain `string`, and a
# broken link passes CI. Regenerate by starting the dev server.
!.expo/types/
.expo/types/*
!.expo/types/router.d.ts
dist/
web-build/
# Normally generated by `expo start` and gitignored, same as
# `.expo/types/router.d.ts` above — but it's the only place `declare module
# '*.css'` comes from (via `expo/types/global.d.ts`), so a CI checkout that
# never runs the dev server fails `tsc --noEmit` on every `.css` import
# without it. Commit it for the same reason as router.d.ts: three stable
# lines, versus a typecheck gate that can't actually run clean in CI.
!expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
# NOTE: `.env*.local` alone does not cover a plain `.env`.
.env
.env*
!.env.example

# typescript
*.tsbuildinfo

app-example

# generated native folders
/ios
/android

# Supabase CLI local link state
supabase/.temp/

# Written by ad-hoc `deno check` runs, not a project lockfile
deno.lock
