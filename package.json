{
  "name": "skincare-recommendation",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "import:cosing": "node scripts/import-cosing.mjs",
    "clean:stubs": "node scripts/clean-ingredient-stubs.mjs",
    "import:inci-dictionary": "node scripts/import-inci-dictionary.mjs",
    "import:obf": "node scripts/import-obf.mjs",
    "prune:incomplete": "node scripts/prune-incomplete-products.mjs",
    "import:wikidata-synonyms": "node scripts/import-wikidata-synonyms.mjs",
    "reclassify-types": "node scripts/reclassify-types.mjs",
    "reclassify-from-tags": "node scripts/reclassify-from-tags.mjs",
    "reconcile:obf": "node scripts/reconcile-obf.mjs",
    "audit:catalogue-quality": "node scripts/audit-catalogue-quality.mjs",
    "audit:duplicate-ingredients": "node scripts/audit-duplicate-ingredients.mjs",
    "audit:safety-labels": "node scripts/audit-safety-labels.mjs",
    "audit:function-tags": "node scripts/audit-function-tags.mjs",
    "fix:duplicate-ingredients": "node scripts/fix-duplicate-ingredients.mjs",
    "audit:ingredient-coverage": "node scripts/audit-ingredient-coverage.mjs",
    "audit:data": "npm run audit:duplicate-ingredients && npm run audit:safety-labels && npm run audit:function-tags && npm run audit:ingredient-coverage -- --check",
    "promotion-plan": "node scripts/promotion-plan.mjs",
    "check:shelf-rls": "node scripts/check-shelf-rls.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/cormorant-garamond": "^0.4.1",
    "@expo-google-fonts/montserrat": "^0.4.2",
    "@expo-google-fonts/playfair-display": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@supabase/supabase-js": "^2.112.4",
    "expo": "57.0.19",
    "expo-apple-authentication": "~57.0.2",
    "expo-camera": "~57.0.4",
    "expo-constants": "~57.0.17",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.4",
    "expo-image-manipulator": "~57.0.15",
    "expo-image-picker": "~57.0.18",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.18",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "nativewind": "^4.2.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.5",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@jest/globals": "~29.7.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.18",
    "babel-jest": "~29.7.0",
    "babel-preset-expo": "~57.0.10",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "tailwindcss": "^3.4.19",
    "test-renderer": "~1.2.0",
    "typescript": "~6.0.3"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "transform": {
      "^.+\\.[jt]sx?$": "babel-jest",
      "^.+\\.mjs$": "babel-jest"
    },
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "mjs"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/.claude/",
      "[\\/]supabase[\\/]"
    ]
  }
}
